// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  adminId      Int       @id @default(autoincrement()) @map("admin_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  email        String    @unique
  role         String    @default("staff") // super_admin, staff
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  auditLogs     AuditLog[]
  pigScans      PigScan[]
  weightLogs    WeightLog[]
  healthLogs    HealthLog[]
  treatments    Treatment[]

  @@map("admins")
}

model AuditLog {
  auditId      Int      @id @default(autoincrement()) @map("audit_id")
  adminId      Int      @map("admin_id")
  actionType   String   @map("action_type") // create, update, delete, login, export
  targetTable  String   @map("target_table")
  targetId     String?  @map("target_id")
  description  String?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  admin        Admin    @relation(fields: [adminId], references: [adminId])

  @@map("audit_logs")
}

model Pig {
  pigId        Int       @id @default(autoincrement()) @map("pig_id")
  rfidTag      String    @unique @map("rfid_tag")
  pigNumber    String    @unique @map("pig_number")
  pigType      String    @map("pig_type") // piglet, sow, boar, gilt
  sire         String?   @map("sire")
  dam          String?   @map("dam")
  pen          String    @map("pen")
  healthStatus String    @default("healthy") @map("health_status") // healthy, at-risk, sick
  weight       Float?    @map("weight")
  dateOfBirth  DateTime  @map("date_of_birth")
  notes        String?   @map("notes")
  lastScanned  DateTime? @map("last_scanned")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scanLogs     PigScan[]
  weightLogs   WeightLog[]
  healthLogs   HealthLog[]
  treatments   Treatment[]

  @@map("pigs")
}

model PigScan {
  scanId    Int      @id @default(autoincrement()) @map("scan_id")
  pigId     Int      @map("pig_id")
  timestamp DateTime @map("timestamp")
  location  String?  @map("location")
  scannedBy Int?     @map("scanned_by")
  notes     String?  @map("notes")

  pig       Pig      @relation(fields: [pigId], references: [pigId])
  admin     Admin?   @relation(fields: [scannedBy], references: [adminId])

  @@map("pig_scans")
}

model WeightLog {
  weightLogId Int      @id @default(autoincrement()) @map("weight_log_id")
  pigId       Int      @map("pig_id")
  weight      Float    @map("weight")
  recordedAt  DateTime @default(now()) @map("recorded_at")
  recordedBy  Int?     @map("recorded_by")
  notes       String?  @map("notes")

  pig         Pig      @relation(fields: [pigId], references: [pigId])
  admin       Admin?   @relation(fields: [recordedBy], references: [adminId])

  @@map("weight_logs")
}

model HealthLog {
  healthLogId    Int      @id @default(autoincrement()) @map("health_log_id")
  pigId          Int      @map("pig_id")
  previousStatus String   @map("previous_status")
  newStatus      String   @map("new_status")
  reason         String?
  recordedBy     Int?     @map("recorded_by")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  pig            Pig      @relation(fields: [pigId], references: [pigId])
  admin          Admin?   @relation(fields: [recordedBy], references: [adminId])

  @@map("health_logs")
}

model Treatment {
  treatmentId    Int       @id @default(autoincrement()) @map("treatment_id")
  pigId          Int       @map("pig_id")
  type           String    @map("type")          // vaccination, deworming, medication, checkup
  name           String    @map("name")          // e.g. "Hog Cholera Vaccine", "Ivermectin"
  dosage         String?   @map("dosage")
  administeredAt DateTime  @map("administered_at")
  nextDueDate    DateTime? @map("next_due_date")
  administeredBy Int?      @map("administered_by")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  pig            Pig       @relation(fields: [pigId], references: [pigId])
  admin          Admin?    @relation(fields: [administeredBy], references: [adminId])

  @@map("treatments")
}
