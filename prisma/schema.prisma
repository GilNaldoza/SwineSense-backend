// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  userId      Int      @id @default(autoincrement()) @map("user_id")
  idNumber    String   @unique @map("id_number")
  rfidTag     String   @unique @map("rfid_tag")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  userType    String @map("user_type") // student, faculty
  college     String?
  department  String?
  yearLevel   String?  @map("year_level")
  status      String   @default("active") // active, inactive
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  entryLogs   EntryLog[]

  @@map("users")
}

model Admin {
  adminId      Int       @id @default(autoincrement()) @map("admin_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  email        String    @unique
  role         String    @default("staff") // super_admin, staff
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relation to logs entered by this staff member (e.g. manual entry or syncing)
  processedLogs EntryLog[]
  
  // Relation to audit logs (actions performed by this admin)
  auditLogs     AuditLog[]

  // Relation to pig scans performed by this admin
  pigScans      PigScan[]

  @@map("admins")
}

model AuditLog {
  auditId      Int      @id @default(autoincrement()) @map("audit_id")
  adminId      Int      @map("admin_id")
  actionType   String   @map("action_type") // create, update, delete, login, export
  targetTable  String   @map("target_table") // users, entry_logs, admins
  targetId     String?  @map("target_id")    // ID of the affected record
  description  String?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  admin        Admin    @relation(fields: [adminId], references: [adminId])

  @@map("audit_logs")
}

model EntryLog {
  logId          Int      @id @default(autoincrement()) @map("log_id")
  
  // Link to User (Student/Faculty)
  user           User?     @relation(fields: [userId], references: [userId])
  userId         Int?      @map("user_id")
  // We keep rfidTag here too in case user is not found/deleted but log remains? 
  // Or just rely on userId. The Client sends rfid_tag. 
  // Let's store scanned rfid_tag for audit if user doesn't exist yet.
  rfidTag        String?   @map("rfid_tag")

  entryTimestamp DateTime @map("entry_timestamp")
  entryMethod    String   @map("entry_method") // rfid, manual
  status         String   @default("success") // success, duplicate, error
  nodeId         String?  @map("node_id")
  location       String?  @map("location") // e.g. Main Library, Graduate Library, CEA, etc.
  
  // Link to Staff who processed this
  staff          Admin?   @relation(fields: [staffId], references: [adminId])
  staffId        Int?     @map("staff_id")
  deletedAt      DateTime? @map("deleted_at")

  createdAt      DateTime @default(now()) @map("created_at")

  @@map("entry_logs")
}

model Pig {
  pigId        Int       @id @default(autoincrement()) @map("pig_id")
  rfidTag      String    @unique @map("rfid_tag")
  pigNumber    String    @unique @map("pig_number")
  pigType      String    @map("pig_type") // piglet, sow, boar, gilt
  sire         String?   @map("sire")
  dam          String?   @map("dam")
  pen          String    @map("pen")
  healthStatus String    @default("healthy") @map("health_status") // healthy, at-risk, sick
  weight       Float?    @map("weight")
  dateOfBirth  DateTime  @map("date_of_birth")
  notes        String?   @map("notes")
  lastScanned  DateTime? @map("last_scanned")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  scanLogs     PigScan[]

  @@map("pigs")
}

model PigScan {
  scanId    Int      @id @default(autoincrement()) @map("scan_id")
  pigId     Int      @map("pig_id")
  timestamp DateTime @map("timestamp")
  location  String?  @map("location")
  scannedBy Int?     @map("scanned_by") // Admin ID
  notes     String?  @map("notes")

  pig       Pig      @relation(fields: [pigId], references: [pigId])
  admin     Admin?   @relation(fields: [scannedBy], references: [adminId])

  @@map("pig_scans")
}
